# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# Auth — REQUIRED. The server refuses to start if this is missing.
# Use a long random value, e.g. `openssl rand -hex 48` or `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=your_jwt_secret_key_here

# CORS — comma-separated list of allowed browser origins.
# No wildcard: requests from unlisted origins are rejected with 403.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# Database Settings (Neon / PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require
PGHOST=ep-sample-host.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=username
PGPASSWORD=your_database_password_here
PGPORT=5432

# Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email Verification — optional SMTP. Without these, verification links are
# printed to the server console (dev fallback) instead of emailed.
# Email transport — when RESEND_API_KEY is set, verification and test emails
# are sent via the Resend SDK (from 'SpenSight <onboarding@resend.dev>').
# Otherwise SMTP creds below are used (which can also be set at runtime from
# the admin Settings page, stored encrypted in the DB, overriding env values).
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=SpenSight <noreply@spensight.app>
VERIFY_PAGE_URL=https://spensight.netlify.app
APP_NAME=SpenSight

# Admin — comma-separated list of user emails allowed to open the
# mail settings page / endpoints. Empty list disables admin endpoints.
ADMIN_EMAILS=you@example.com
# Forgot-password email (Nodemailer / Gmail SMTP).
# Gmail: use an App Password (Google Account > Security > 2-step verification > App passwords).
# Generate one at https://myaccount.google.com/apppasswords
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_16_char_app_password
