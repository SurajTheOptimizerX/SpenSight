{
  "env": {
    "node": true,
    "es2021": true,
    "browser": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "globals": {
    "SpenIcons": "readonly",
    "Chart": "readonly",
    "html2pdf": "readonly",
    "apiRequest": "readonly",
    "apiUpload": "readonly",
    "getToken": "readonly",
    "getStoredUser": "readonly",
    "authAPI": "readonly",
    "dataAPI": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  }
}